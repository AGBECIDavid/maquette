# CartePro — variables d'environnement
# Copier en .env.local et compléter. Aucun secret n'est versionné (§5.2).

# ── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="CartePro"
NEXT_PUBLIC_APP_VERSION="2.0.0"
# Affiche la mention de simulation partout où un montant apparaît (§4.1).
# Ne jamais passer à "false" tant que le dispositif n'a pas d'agrément.
NEXT_PUBLIC_SIMULATION="true"

# ── Base de données (cible : PostgreSQL local, §5.2) ────────────────────────
# Aucune base hébergée, aucun service managé : l'application doit démarrer
# entièrement sur la machine de qui récupère le dépôt.
DATABASE_URL="postgresql://cartepro:cartepro@localhost:5432/cartepro"

# ── Sessions ────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
SESSION_SECRET=""
SESSION_TTL_MINUTES="60"

# ── Règles métier (§3) ──────────────────────────────────────────────────────
# R4 — validité du code de paiement, en secondes. 300 = 5 minutes.
PAYMENT_TOKEN_TTL_SECONDS="300"
# Clé de signature des codes de paiement, côté serveur uniquement.
PAYMENT_TOKEN_SECRET=""

# ── Conservation des données (§4.2) ─────────────────────────────────────────
DATA_RETENTION_MONTHS="13"

# ── Journalisation ──────────────────────────────────────────────────────────
LOG_LEVEL="info"
